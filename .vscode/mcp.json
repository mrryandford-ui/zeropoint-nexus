{
  // ZeroPoint MCP Server — VS Code MCP Configuration
  // Place this file at: <repo-root>/.vscode/mcp.json
  // VS Code Copilot and Claude-for-VSCode will pick this up automatically.
  //
  // Prerequisites:
  //   1. Run install_zeropoint_windows.ps1 as Administrator (one-time)
  //   2. Run dev_start.ps1 to start the local MCP server
  //   3. Set MCP_AUTH_TOKEN in your environment (from config/.env)
  //      or VS Code will fall back to the value in config/.env automatically
  //      if the server is started via dev_start.ps1.
  //
  // VS Code settings required (settings.json):
  //   "github.copilot.chat.agent.mcpServers": true

  "servers": {
    // -----------------------------------------------------------------------
    // ZeroPoint MCP — primary local server
    // Exposes: filesystem, webtools, adb, android/camnet tools
    // -----------------------------------------------------------------------
    "zeropoint": {
      "type": "http",
      "url": "http://localhost:8765/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MCP_AUTH_TOKEN}"
      },
      "description": "ZeroPoint AI stack — filesystem, webtools, ADB, and CamNet Android automation.",
      "enabled": true
    },

    // -----------------------------------------------------------------------
    // ZeroPoint MCP — SSE stream endpoint (for streaming tool responses)
    // Used by clients that prefer Server-Sent Events over plain HTTP POST.
    // -----------------------------------------------------------------------
    "zeropoint-sse": {
      "type": "sse",
      "url": "http://localhost:8765/sse",
      "headers": {
        "Authorization": "Bearer ${env:MCP_AUTH_TOKEN}"
      },
      "description": "ZeroPoint MCP streaming (SSE) endpoint.",
      "enabled": false
    },

    // -----------------------------------------------------------------------
    // Filesystem tool (direct stdio mode — alternative to HTTP)
    // Use this if you want the filesystem server to run as a subprocess
    // managed entirely by VS Code rather than your dev_start.ps1 process.
    // Requires: .venv\Scripts\python.exe to exist (run installer first).
    // -----------------------------------------------------------------------
    "zeropoint-fs-stdio": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "zeropoint.server",
        "--config",
        "${workspaceFolder}\\config\\mcp_server_config.yaml",
        "--tools",
        "filesystem",
        "--transport",
        "stdio"
      ],
      "env": {
        "MCP_AUTH_TOKEN": "${env:MCP_AUTH_TOKEN}",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "description": "ZeroPoint filesystem tool — stdio subprocess mode.",
      "enabled": false
    }
  },

  // -----------------------------------------------------------------------
  // Tool visibility — which tools Copilot may use by default.
  // Fine-tune per-session in the Copilot chat tool picker.
  // -----------------------------------------------------------------------
  "toolSets": {
    "zeropoint-safe": {
      "description": "Read-only filesystem + web fetch — safe for ambient use.",
      "tools": [
        "zeropoint://filesystem_read",
        "zeropoint://filesystem_list",
        "zeropoint://filesystem_search",
        "zeropoint://webtools_fetch",
        "zeropoint://webtools_scrape",
        "zeropoint://adb_devices",
        "zeropoint://adb_screenshot"
      ]
    },
    "zeropoint-full": {
      "description": "Full tool access including write, ADB shell, and CamNet.",
      "tools": [
        "zeropoint://filesystem_read",
        "zeropoint://filesystem_write",
        "zeropoint://filesystem_list",
        "zeropoint://filesystem_search",
        "zeropoint://filesystem_delete",
        "zeropoint://webtools_fetch",
        "zeropoint://webtools_scrape",
        "zeropoint://webtools_search",
        "zeropoint://adb_devices",
        "zeropoint://adb_shell",
        "zeropoint://adb_push",
        "zeropoint://adb_pull",
        "zeropoint://adb_install_apk",
        "zeropoint://adb_screenshot",
        "zeropoint://adb_logcat",
        "zeropoint://android_tap",
        "zeropoint://android_swipe",
        "zeropoint://android_type_text",
        "zeropoint://android_launch_app",
        "zeropoint://android_ui_dump",
        "zeropoint://android_back",
        "zeropoint://android_home",
        "zeropoint://camnet_status",
        "zeropoint://camnet_capture_all",
        "zeropoint://camnet_capture_device",
        "zeropoint://camnet_sync_media",
        "zeropoint://camnet_connect_all",
        "zeropoint://camnet_health_check"
      ]
    }
  }
}
