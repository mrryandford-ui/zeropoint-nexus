{
  // ZeroPoint MCP Server — VS Code MCP Configuration
  // Place this file at: <repo-root>/.vscode/mcp.json
  // VS Code Copilot and Claude-for-VSCode will pick this up automatically.
  //
  // Prerequisites:
  //   1. Run install_zeropoint_windows.ps1 as Administrator (one-time)
  //   2. Run dev_start.ps1 to start the local MCP server
  //   3. Set MCP_AUTH_TOKEN in your environment (from config/.env)
  //      or VS Code will fall back to the value in config/.env automatically
  //      if the server is started via dev_start.ps1.
  //
  // VS Code settings required (settings.json):
  //   "github.copilot.chat.agent.mcpServers": true

  // ZeroPoint uses stdio because the HTTP endpoint is WebSocket-only.
  "servers": {
    "zeropoint": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "zeropoint.server",
        "--transport",
        "stdio",
        "--config",
        "${workspaceFolder}\\config\\mcp_server_config.yaml"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "description": "ZeroPoint local filesystem and web tools."
    }
  },

  // -----------------------------------------------------------------------
  // Tool visibility — which tools Copilot may use by default.
  // Fine-tune per-session in the Copilot chat tool picker.
  // -----------------------------------------------------------------------
  "toolSets": {
    "zeropoint-safe": {
      "description": "Read-only filesystem + web fetch — safe for ambient use.",
      "tools": [
        "zeropoint://filesystem_read",
        "zeropoint://filesystem_list",
        "zeropoint://webtools_fetch",
        "zeropoint://webtools_scrape",
        "zeropoint://webtools_search"
      ]
    },
    "zeropoint-full": {
      "description": "Full tool access including write, ADB shell, and CamNet.",
      "tools": [
        "zeropoint://filesystem_read",
        "zeropoint://filesystem_write",
        "zeropoint://filesystem_list",
        "zeropoint://webtools_fetch",
        "zeropoint://webtools_scrape",
        "zeropoint://webtools_search"
      ]
    }
  }
}
